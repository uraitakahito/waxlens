{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "A: waxlens-validate (built dist)",
      "preLaunchTask": "pnpm: build @waxlens/core",
      "program": "${workspaceFolder}/packages/core/dist/cli.js",
      "args": ["${input:waczPath}"],
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/packages/core/dist/**/*.js"
      ],
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "A: waxlens TUI plain (built dist)",
      "preLaunchTask": "pnpm: build @waxlens/tui",
      "program": "${workspaceFolder}/packages/tui/dist/cli.js",
      "args": ["${input:waczPath}", "--no-tui"],
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/packages/tui/dist/**/*.js",
        "${workspaceFolder}/packages/core/dist/**/*.js"
      ],
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ]
    }
  ],
  "inputs": [
    {
      "id": "waczPath",
      "type": "promptString",
      "description": "WACZ file path or s3:// URI",
      "default": "/tmp/waxlens-demo/wikipedia.wacz"
    }
  ]
}
